# Copy to .env.local and fill in real values for local development / Vercel project settings.
# None of these are required for the parser/Add flow to work — only for Web Push daily reminders.

# VAPID keypair for Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL/email required by the Web Push protocol, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Optional: Upstash/Vercel KV REST API, used to durably store push subscriptions in production.
# If unset, subscriptions fall back to a local JSON file (.data/push-subscriptions.json) which
# is fine for local dev but is NOT durable on serverless hosting (e.g. Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required in production/Vercel (optional for local dev): shared secret checked as an
# Authorization header value on /api/cron/daily-reminder requests. Without it, that endpoint
# refuses to run outside local development, since it can trigger a bulk push send.
CRON_SECRET=
